{
  // Zed rewrites this file when settings are changed from the UI (font size,
  // theme picker, vim mode toggle). Edit ~/.config/zed/settings.json directly,
  // then `chezmoi add ~/.config/zed/settings.json` to pull the change back in.
  "icon_theme": "Zed (Default)",
  "cli_default_open_behavior": "existing_window",
  "which_key": {
    "enabled": false
  },
  "on_last_window_closed": "quit_app",
  "vim_mode": true,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha",
  },
  "buffer_font_family": "PlemolJP Console NF",
  "buffer_font_size": 13,
  "ui_font_size": 14,
  "relative_line_numbers": "enabled",
  "tab_size": 2,
  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "soft_wrap": "editor_width",
  "preferred_line_length": 120,
  // Mirrors the nvim lsp.lua setup. Zed's inlay_hints block only decides which
  // kinds are rendered; TypeScript also has to be told to emit them, which is
  // what the vtsls block under "lsp" below does.
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "shell": {
      "program": "zsh",
    },
    "font_family": "PlemolJP Console NF",
    "font_size": 13,
    "copy_on_select": true,
  },
  "auto_install_extensions": {
    "ruby": true,
    "elixir": true,
    "nix": true,
    "toml": true,
    "terraform": true,
    "dockerfile": true,
    "sql": true,
    "lua": true,
    "make": true,
    "html": true,
    "git-firefly": true,
    // Theme extensions. theme.dark above names one of these, and the name only
    // resolves on a fresh machine if the extension is listed here — Zed does
    // not add it when a theme is picked from the UI. Keep both registered so
    // switching between them needs no change down here.
    "catppuccin": true,
    "tokyo-night": true,
  },
  "languages": {
    "Ruby": {
      "language_servers": ["ruby-lsp", "!solargraph"],
    },
    // JS/TS/TSX intentionally have no formatter override: Zed's bundled
    // prettier picks up each project's .prettierrc, matching the nvim conform
    // setup and this repo's CI. Do not point these at biome unless the biome
    // extension is added to auto_install_extensions above.
    "Markdown": {
      "format_on_save": "off",
    },
  },
  "lsp": {
    // vtsls is Zed's TypeScript server. These are the same hint kinds the nvim
    // config enables for ts_ls; without them the server emits nothing and the
    // inlay_hints block above has no effect on TS/JS.
    "vtsls": {
      "settings": {
        "typescript": {
          "inlayHints": {
            "parameterNames": { "enabled": "all" },
            "parameterTypes": { "enabled": true },
            "variableTypes": { "enabled": true },
            "propertyDeclarationTypes": { "enabled": true },
            "functionLikeReturnTypes": { "enabled": true },
          },
        },
        "javascript": {
          "inlayHints": {
            "parameterNames": { "enabled": "all" },
            "parameterTypes": { "enabled": true },
            "variableTypes": { "enabled": true },
            "propertyDeclarationTypes": { "enabled": true },
            "functionLikeReturnTypes": { "enabled": true },
          },
        },
      },
    },
  },
}
