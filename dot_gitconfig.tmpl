[core]
  excludesfile = ~/.gitignore
  editor = nvim
  whitespace = trailing-space,space-before-tab
  pager = delta
  quotepath = false
{{ if and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | contains "WSL") }}
  sshCommand = ssh.exe
{{ end }}
[user]
  name = bobstrange
  email = bob.1983.g@gmail.com
[push]
  default = simple
[filter "lfs"]
  clean = git-lfs clean %f
  smudge = git-lfs smudge %f
  required = true

[alias]
  br = branch
  cb = rev-parse --abbrev-ref HEAD
  cm = commit -m
  co = checkout
  sw = switch
  fap = fetch --all --prune
  fp = push --force-with-lease
  lo = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
  st = status
  files = ! git status --short | sed s/^...//

  amend = commit --amend --no-edit
  delete = branch --delete
  delete-merged = "!git merged | while read -r branch; do git branch -D \"$branch\"; done"
  delete-remote = push --delete origin
  delete-tag = tag --delete
  discard = restore --
  modified = ! git diff --name-only --diff-filter=M
  unstage = reset -q HEAD --
  uncommit = reset --mixed HEAD~
  push-upstream = !git push -u origin $(git cb)
  sync-tag = !git tag -l | xargs git delete-tag && git fetch origin --tags

  # git rebase-onto <to> <from>
  rebase-onto = "!f() { git rebase --onto $1 $2 $(git cb); }; f"

[commit]
  template = ~/.stCommitMsg

[ghq]
  root = ~/src

[hub]
  protocol = https

# diff and merge
[merge]
  tool = vimdiff
[mergetool]
  prompt = true
[mergetool "vimdiff"]
  cmd = nvim -d $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'
[difftool]
  prompt = false
[diff]
  tool = vimdiff

# Make gitconfig space 2
[filter "spacify"]
  clean = expand --tabs=2 --initial
[rerere]
	enabled = true
[advice]
  skippedCherryPicks = false

# git-delta related config
[interactive]
  diffFilter = delta --color-only

[include]
  path = ~/.gitconfig.d/themes.gitconfig

[delta]
  # Use arctic-fox theme
  features = arctic-fox side-by-side-view
  navigate = true
  line-numbers = true
  hyperlinks = true
  keep-plus-minus-markers = true

[delta "side-by-side-view"]
  side-by-side = true

[merge]
  conflictstyle = zdiff3

{{/* credential start */}}

{{ if eq .chezmoi.os "darwin" }}

[credential]
  helper = osxkeychain

{{ else if eq .chezmoi.os "linux" }}
  {{ if .chezmoi.kernel.osrelease | contains "WSL" }}

[credential]
  helper = /mnt/c/Users/bob19/scoop/shims/git-credential-manager.exe

  {{ else }}

[credential "https://github.com"]
  helper = !gh auth git-credential
[credential "https://gist.github.com"]
  helper = !gh auth git-credential

  {{ end }}
{{ end }}

{{/* credential end */}}
