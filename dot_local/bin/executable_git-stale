#!/usr/bin/env sh
# List local branches that have gone quiet, oldest first, with what decides whether one can
# go: where it tracks ([gone] means the remote branch was deleted, typically at merge), how
# far it has drifted, and which worktree still holds it. `git stale 0` lists every branch.
set -eu

days=${1:-30}
cutoff=$(($(date +%s) - days * 86400))

# Columns are aligned here rather than through column(1), which is not everywhere.
git for-each-ref refs/heads --sort=committerdate \
  --format='%(committerdate:unix)%09%(committerdate:short)%09%(refname:short)%09%(upstream:short)%09%(upstream:track)%09%(worktreepath)' |
  awk -F'\t' -v cutoff="$cutoff" '
    BEGIN {
      cols = 4
      split("DATE BRANCH REMOTE WORKTREE", header, " ")
      rows = 1

      for (c = 1; c <= cols; c++) {
        cell[1, c] = header[c]
        width[c] = length(header[c])
      }
    }

    $1 > cutoff { next }

    {
      # One compact token: the column has to stay narrow enough to survive next to a
      # preview pane, so counts collapse to +ahead/-behind and the upstream name appears
      # only when it is not this branch on the remote (a stale origin/master).
      if ($4 == "") {
        remote = "-"
      } else if ($5 == "") {
        remote = "synced"
      } else if ($5 == "[gone]") {
        remote = "gone"
      } else {
        remote = ""
        if (match($5, /ahead [0-9]+/)) {
          remote = "+" substr($5, RSTART + 6, RLENGTH - 6)
        }
        if (match($5, /behind [0-9]+/)) {
          remote = remote (remote == "" ? "" : " ") "-" substr($5, RSTART + 7, RLENGTH - 7)
        }
      }

      if ($4 != "" && $4 !~ ("/" $3 "$")) {
        remote = remote " ->" $4
      }

      worktree = $6
      sub(/.*\//, "", worktree)

      rows++
      cell[rows, 1] = $2
      cell[rows, 2] = $3
      cell[rows, 3] = remote
      cell[rows, 4] = worktree

      for (c = 1; c <= cols; c++) {
        if (length(cell[rows, c]) > width[c]) {
          width[c] = length(cell[rows, c])
        }
      }
    }

    END {
      for (r = 1; r <= rows; r++) {
        line = ""

        for (c = 1; c < cols; c++) {
          line = line sprintf("%-" (width[c] + 2) "s", cell[r, c])
        }

        print line cell[r, cols]
      }
    }
  '
