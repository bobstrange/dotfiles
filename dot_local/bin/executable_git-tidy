#!/usr/bin/env sh
# Pick branches to delete, previewing each one's recent commits.
set -eu

preview="git log --color --format='%Cred%h %Cgreen%cd %C(bold blue)%an%Creset %s' --date=format:'%Y-%m-%d %H:%M' -20 {}"

branches=$(git branch --format='%(refname:short)' | fzf --multi --preview "$preview") || exit 0

# BSD xargs has no --no-run-if-empty, so guard here rather than in a pipeline.
[ -n "$branches" ] || exit 0

echo "$branches" | while read -r branch; do
  status=0
  git delete-branch "$branch" || status=$?

  # Stranded commits are the picker's call to overrule; a worktree that refused to go is not.
  if [ "$status" -eq 2 ]; then
    # fzf consumed stdin, so the prompt has to talk to the terminal directly.
    printf 'delete %s anyway? [y/N] ' "$branch" > /dev/tty
    read -r answer < /dev/tty

    case "$answer" in
      y | Y) git delete-branch --force "$branch" || true ;;
    esac
  fi
done
