#!/usr/bin/env sh
# Pick branches to delete, previewing each one's recent commits.
set -eu

preview="git log --color --format='%Cred%h %Cgreen%cd %C(bold blue)%an%Creset %s' --date=format:'%Y-%m-%d %H:%M' -20 {2}"

# `git stale 0` is the same table, oldest first, so the picker shows why a branch is a
# candidate — its age, whether the remote branch is [gone], and any worktree holding it.
# The preview goes below rather than beside: a half-width list truncates the columns that
# say whether a branch can go.
selection=$(git stale 0 |
  fzf --multi --header-lines=1 --preview "$preview" --preview-window=down,60%) || exit 0

# fzf exits 0 with empty output when nothing is picked.
[ -n "$selection" ] || exit 0

printf '%s\n' "$selection" | awk '{ print $2 }' | while read -r branch; do
  status=0
  git delete-branch "$branch" || status=$?

  # Stranded commits are the picker's call to overrule; a worktree that refused to go is not.
  if [ "$status" -eq 2 ]; then
    # fzf consumed stdin, so the prompt has to talk to the terminal directly.
    printf 'delete %s anyway? [y/N] ' "$branch" > /dev/tty
    read -r answer < /dev/tty

    case "$answer" in
      y | Y) git delete-branch --force "$branch" || true ;;
    esac
  fi
done
