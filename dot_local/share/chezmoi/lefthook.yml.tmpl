extends:
  - {{ .chezmoi.homeDir }}/.config/lefthook/lefthook.yml

pre-commit:
  parallel: true
  commands:
    trailing-whitespace:
      run: git diff --cached --check
    prettier-check:
      glob: "*.{md,json,yaml,yml}"
      run: npx --yes --prefer-offline prettier@3.9.6 --check {staged_files}
    markdownlint:
      glob: "*.md"
      run: markdownlint-cli2 {staged_files}
