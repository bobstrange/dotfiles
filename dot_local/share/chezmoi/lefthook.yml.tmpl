extends:
  - {{ .chezmoi.homeDir }}/.config/lefthook/lefthook.yml

pre-commit:
  parallel: true
  commands:
    trailing-whitespace:
      run: git diff --cached --check
    prettier-check:
      glob: "*.{md,json,yaml,yml}"
      # Resolves node_modules/.bin/prettier, pinned in package.json — run
      # `npm ci` (or `make lefthook-setup`) if this cannot find it.
      run: npx prettier --check {staged_files}
    markdownlint:
      glob: "*.md"
      run: markdownlint-cli2 {staged_files}
