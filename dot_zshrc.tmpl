# Auto-attach to tmux when running inside a GUI terminal (not already in tmux)
if [[ -n "$TERM_PROGRAM" ]] && [[ -z "$TMUX" ]]; then
  tmux new-session -A -s main 2>/dev/null || true
fi

# History settings (must be set before autosuggestions plugin)
source "$HOME/.zsh/configs/history.zsh"

# Set fpath before compinit (Nix completions + custom completions)
fpath=(
  "$HOME/.nix-profile/share/zsh/site-functions"
  "${XDG_DATA_HOME:-$HOME/.local/share}/zsh/completions"
{{- if eq .chezmoi.os "darwin" }}
  # Homebrew's version-independent core functions dir. Survives `brew upgrade
  # zsh` version bumps that would otherwise leave a stale Cellar path (e.g.
  # .../Cellar/zsh/5.9/...) in an inherited FPATH from a long-lived tmux server
  # and break compinit / add-zsh-hook / compdef.
  /opt/homebrew/share/zsh/functions
{{- end }}
  $fpath
)
# Dedupe, and drop anything that is not an existing directory — prunes a stale
# Cellar path inherited via FPATH after a zsh upgrade so compinit can still find
# the current version. (N) alone would keep a regular file that happened to sit
# at one of these paths; -/ restricts to directories, following symlinks.
typeset -U fpath
fpath=(${^fpath}(N-/))

# Load plugin manager (compinit is handled by sheldon hooks)
if command -v sheldon &>/dev/null; then
  eval "$(sheldon source)"
fi

{{ if eq .chezmoi.os "linux" -}}
# Load ubuntu related configurations
for zsh_source in "$HOME"/.zsh/configs/ubuntu/*.zsh; do
  source "$zsh_source"
done
{{ end -}}

{{ if and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | contains "WSL") -}}
# Load wsl(ubuntu) related configuration
for zsh_source in "$HOME"/.zsh/configs/wsl/*.zsh; do
  source "$zsh_source"
done

# Set umask 022 only if it's wsl
umask 022
{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
# Load osx related configurations
for zsh_source in "$HOME"/.zsh/configs/darwin/*.zsh; do
  source "$zsh_source"
done
{{ end -}}

# load custom configurations
for zsh_source in "$HOME"/.zsh/configs/*.zsh; do
  source "$zsh_source"
done

[[ -f "$HOME/.zsh_aliases" ]] && source "$HOME/.zsh_aliases"

[[ -f "$HOME/.zsh_aliases.local" ]] && source "$HOME/.zsh_aliases.local"

# load functions
for zsh_source in "$HOME"/.zsh/functions/*.zsh; do
  source "$zsh_source"
done

{{ if eq .chezmoi.os "linux" -}}
# Load linux-specific functions
for zsh_source in "$HOME"/.zsh/functions/linux/*.zsh; do
  source "$zsh_source"
done
{{ end -}}

# Ensure nix-installed tools take priority (must be last)
[ -d "$HOME/.nix-profile/bin" ] && export PATH="$HOME/.nix-profile/bin:$PATH"
