{
  "name": "dotfiles",
  "private": true,
  "description": "Dev-only tooling for this repo. Not installed by chezmoi; see .chezmoiignore.",
  "scripts": {
    "format": "prettier --write \"**/*.{md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{md,json,yaml,yml}\"",
    "lint:secrets": "secretlint \"**/*\""
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "prettier": "3.9.10",
    "secretlint": "13.1.0"
  }
}
