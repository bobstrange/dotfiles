Include config.d/*.conf

Host *
    StrictHostKeyChecking accept-new
    # Send keepalive every 60s, disconnect after 3 failed attempts (~3min)
    ServerAliveInterval 60
    ServerAliveCountMax 3
{{- if not (index . "work") }}
    # Personal machines only: pin ssh to the 1Password SSH agent. Without this,
    # ssh falls back to SSH_AUTH_SOCK, which the desktop session points at its
    # own agent (GNOME Keyring's /run/user/*/keyring/ssh) holding no keys.
    # Work machines keep whatever agent their session provides — set the agent
    # per host in config.d/work.conf if they need 1Password too.
{{- if eq .chezmoi.os "darwin" }}
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- else if and (eq .chezmoi.os "linux") (not (.chezmoi.kernel.osrelease | contains "WSL")) }}
    # WSL is excluded: it uses its own ssh-agent (.zsh/configs/wsl/ssh_agent.zsh).
    IdentityAgent ~/.1password/agent.sock
{{- end }}
{{- end }}
